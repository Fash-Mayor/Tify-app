{
  "expo": {
    "name": "Tify",
    "slug": "tify",
    "scheme": "tify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#090A0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fashmayor.tify"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#090A0F"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.fashmayor.tify",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "open.spotify.com",
              "pathPrefix": "/track"
            },
            {
              "scheme": "https",
              "host": "spotify.link"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "open.spotify.com",
              "pathPrefix": "/track"
            },
            {
              "scheme": "https",
              "host": "spotify.link"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "name": "Tify",
      "shortName": "Tify",
      "favicon": "./assets/logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withAndroidShareTarget"
    ],
    "extra": {
      "eas": {
        "projectId": "0064f7ee-541f-468b-bee0-3c5909ac5bb5"
      }
    },
    "owner": "fashmayor",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0064f7ee-541f-468b-bee0-3c5909ac5bb5"
    }
  }
}
